  "title": {
    "text": "본인 INTP인데 다른 INTP 만나면 피함",
    "startTime": 0,
    "endTime": 24000
  },
  "bodySections": [
    {
      "id": "g1",
      "startTime": 700,
      "endTime": 2400,
      "lines": [
        { "text": "나도 INTP인데", "startTime": 700, "endTime": 2400 }
      ]
    },
    {
      "id": "g2",
      "startTime": 2500,
      "endTime": 5200,
      "lines": [
        { "text": "모임에서 딱 봐도", "startTime": 2500, "endTime": 3400 },
        { "text": "INTP 같은 사람 있으면", "startTime": 3400, "endTime": 4300 },
        { "text": "좀 피하는 편임.", "startTime": 4300, "endTime": 5200 }
      ]
    },
    {
      "id": "g3",
      "startTime": 5300,
      "endTime": 6700,
      "lines": [
        { "text": "싫어서 그런 건 아니고", "startTime": 5300, "endTime": 6700 }
      ]
    },
    {
      "id": "g4",
      "startTime": 6800,
      "endTime": 8200,
      "lines": [
        { "text": "그 사람이 말하는 거 듣다 보면", "startTime": 6800, "endTime": 8200 }
      ]
    },
    {
      "id": "g5",
      "startTime": 10900,
      "endTime": 12300,
      "lines": [
        { "text": "싶을 때가 있음.", "startTime": 10900, "endTime": 12300 }
      ]
    },
    {
      "id": "g6",
      "startTime": 12400,
      "endTime": 13800,
      "lines": [
        { "text": "근데 그게 왜 보이냐면", "startTime": 12400, "endTime": 13800 }
      ]
    },
    {
      "id": "g7",
      "startTime": 13900,
      "endTime": 16800,
      "lines": [
        { "text": "내가 예전에 똑같이 말했다가", "startTime": 13900, "endTime": 15300 },
        { "text": "사람들 반응 싸해지는 걸 여러 번 겪어봤기 때문임.", "startTime": 15300, "endTime": 16800 }
      ]
    }
  ],
  "emphasis": {
    "text": "아…… 저 말 지금 하면 안 되는데.",
    "startTime": 8300,
    "endTime": 10800
  },
  "conclusion": {
    "lines": ["그래서 INTP 만나면", "동족애보다", "거울치료가 먼저 옴."],
